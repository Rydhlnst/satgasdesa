{
  "expo": {
    "name": "SATGAS DESA SEJOLI",
    "slug": "satgas-desa-sejoli",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "satgasdesa",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SATGAS DESA SEJOLI to access photos for operational evidence.",
          "cameraPermission": "Allow SATGAS DESA SEJOLI to take photos for operational evidence."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SATGAS DESA SEJOLI to use your location for field verification."
        }
      ],
      "expo-document-picker",
      "react-native-edge-to-edge",
      "expo-sharing"
    ],
    "android": {
      "package": "id.satgas.desasejoli",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12304A"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "469e567b-1947-48ce-9c44-82a7275b7c80"
      }
    },
    "owner": "riyannas"
  }
}
