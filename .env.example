NODE_ENV=production
APP_DOMAIN=satgas.beres.io
APP_PORT=3000
# Set this to the GitHub commit SHA deployed by Coolify for diagnostics.
APP_REVISION=unknown
MYSQL_DATABASE=satgas
MYSQL_USER=satgas
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Leave empty for the default database. Set a new unique name only to start with an empty database.
MYSQL_DATA_VOLUME_NAME=
# DATABASE_URL is generated automatically by docker-compose.yml for the app service.
DATABASE_URL=
DB_CONNECTION_LIMIT=5
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EMAIL_PROVIDER=disabled
EMAIL_FROM=
RESEND_API_KEY=
# Keep the bucket private. The app uses short-lived signed upload/download URLs.
STORAGE_PROVIDER=disabled
# Use filesystem/cpanel on a writable cPanel Node.js deployment.
STORAGE_LOCAL_ROOT=public/uploads
STORAGE_BUCKET=
# R2 S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
PUSH_NOTIFICATIONS_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
ROAD_ENTRY_DUE_AUTOMATION_ENABLED=false
DAILY_AUTOMATION_ENABLED=false
MONTHLY_DUE_DAY=10
AUTOMATION_ACTOR_USER_ID=
CRON_SECRET=
SEED_RBAC=false
# Temporary local/demo accounts only. Never run the demo-user seeder in production.
SEED_ROLES=BENDAHARA,PETUGAS_LAPANGAN
SEED_BENDAHARA_PASSWORD=
SEED_PETUGAS_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Set true only while diagnosing startup failures in Coolify. The app remains running but unhealthy.
KEEP_CONTAINER_RUNNING_ON_STARTUP_FAILURE=false
